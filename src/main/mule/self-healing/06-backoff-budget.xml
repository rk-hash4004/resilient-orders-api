<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<!--
		Option B + total time budget. Same as 04-backoff-jitter.xml, plus one rule:
		stop retrying when (time already spent + the next wait) would go past budgetMs.
		Why: the caller (browser, gateway) gives up after some seconds. Retrying past that only wastes work.
		Query params: sku, budgetMs (default 6000).
	-->
	<flow name="self-healing-backoff-budget-flow">
		<http:listener config-ref="order-experience-api-httpListenerConfig" path="/self-healing/backoff-budget">
			<http:response statusCode="#[vars.httpStatus default 200]" />
		</http:listener>
		<ee:transform doc:name="Settings">
			<ee:variables>
				<ee:set-variable variableName="idemKey"><![CDATA[uuid()]]></ee:set-variable>
				<ee:set-variable variableName="sku"><![CDATA[attributes.queryParams.sku default 'TILE-1']]></ee:set-variable>
				<ee:set-variable variableName="baseMs"><![CDATA[500]]></ee:set-variable>
				<ee:set-variable variableName="jitterMs"><![CDATA[250]]></ee:set-variable>
				<ee:set-variable variableName="maxAttempts"><![CDATA[5]]></ee:set-variable>
				<ee:set-variable variableName="budgetMs"><![CDATA[(attributes.queryParams.budgetMs default 6000) as Number]]></ee:set-variable>
				<ee:set-variable variableName="startedAt"><![CDATA[now() as Number {unit: "milliseconds"}]]></ee:set-variable>
				<ee:set-variable variableName="statusCode"><![CDATA[null]]></ee:set-variable>
				<ee:set-variable variableName="budgetReached"><![CDATA[false]]></ee:set-variable>
				<ee:set-variable variableName="attemptsMade"><![CDATA[0]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<!-- vars.counter = attempt number (1, 2, 3 ...), provided by foreach. A pass runs only while there is no success yet and the budget is not used up. -->
		<foreach collection="#[1 to vars.maxAttempts]">
			<choice>
				<when expression="#[vars.statusCode == null and vars.budgetReached == false]">
					<try>
						<flow-ref name="self-healing-call-inventory" />
						<!-- reaching this line means the status was 2xx (Mule raises an error otherwise) -->
						<ee:transform doc:name="Save response">
							<ee:variables>
								<ee:set-variable variableName="statusCode"><![CDATA[attributes.statusCode]]></ee:set-variable>
								<ee:set-variable variableName="reservation"><![CDATA[payload]]></ee:set-variable>
							</ee:variables>
						</ee:transform>
						<error-handler>
							<!-- Temporary error. Work out the next wait and how much time is already spent. -->
							<on-error-continue type="HTTP:SERVICE_UNAVAILABLE, HTTP:TIMEOUT, HTTP:CONNECTIVITY, HTTP:INTERNAL_SERVER_ERROR, HTTP:TOO_MANY_REQUESTS">
								<ee:transform doc:name="Work out next wait">
									<ee:variables>
										<ee:set-variable variableName="attemptsMade"><![CDATA[vars.counter]]></ee:set-variable>
										<ee:set-variable variableName="delayMs"><![CDATA[vars.baseMs * (2 pow (vars.counter - 1)) + randomInt(vars.jitterMs)]]></ee:set-variable>
										<ee:set-variable variableName="spentMs"><![CDATA[(now() as Number {unit: "milliseconds"}) - vars.startedAt]]></ee:set-variable>
									</ee:variables>
								</ee:transform>
								<choice>
									<!-- Attempts left AND the wait fits in the budget: wait, then the loop tries again -->
									<when expression="#[vars.counter &lt; vars.maxAttempts and (vars.spentMs + vars.delayMs) &lt;= vars.budgetMs]">
										<logger level="WARN" message="#['attempt ' ++ vars.counter ++ ' failed, waiting ' ++ vars.delayMs ++ ' ms (spent ' ++ vars.spentMs ++ ' of ' ++ vars.budgetMs ++ ' ms)']" />
										<ee:transform doc:name="Wait">
											<ee:message>
												<ee:set-payload><![CDATA[%dw 2.0
import wait from dw::Runtime
output application/json
---
wait(payload, vars.delayMs)]]></ee:set-payload>
											</ee:message>
										</ee:transform>
									</when>
									<!-- Attempts left but the wait does not fit: stop now, do not sleep -->
									<when expression="#[vars.counter &lt; vars.maxAttempts]">
										<logger level="WARN" message="#['attempt ' ++ vars.counter ++ ' failed, time budget reached (spent ' ++ vars.spentMs ++ ' ms, next wait ' ++ vars.delayMs ++ ' ms, budget ' ++ vars.budgetMs ++ ' ms), giving up']" />
										<set-variable variableName="budgetReached" value="#[true]" />
									</when>
								</choice>
							</on-error-continue>
						</error-handler>
					</try>
				</when>
			</choice>
		</foreach>
		<!-- After the loop: no success means we ran out of attempts or out of time. Raise our own error. -->
		<choice>
			<when expression="#[vars.statusCode == null]">
				<raise-error type="CUSTOM:RETRY_EXHAUSTED" description="Inventory still failing, retries stopped" />
			</when>
		</choice>
		<ee:transform doc:name="Success response">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  outcome: "SUCCESS",
  statusCode: vars.statusCode,
  idempotencyKey: vars.idemKey,
  downstream: vars.reservation
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler>
			<on-error-continue type="CUSTOM:RETRY_EXHAUSTED">
				<ee:transform doc:name="Retries exhausted">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  outcome: "RETRY_EXHAUSTED",
  reason: if (vars.budgetReached) "TIME_BUDGET_REACHED" else "MAX_ATTEMPTS",
  attempts: vars.attemptsMade,
  budgetMs: vars.budgetMs,
  idempotencyKey: vars.idemKey
}]]></ee:set-payload>
					</ee:message>
					<ee:variables>
						<ee:set-variable variableName="httpStatus"><![CDATA[503]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-continue>
		</error-handler>
	</flow>
</mule>
