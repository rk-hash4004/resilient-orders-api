	<munit:test name="post-orders-happy-path-test" doc:id="e30eb698-81c1-4f67-8914-406088a7171a" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock Duplicate Check Success" doc:id="9e9902e9-e8a7-4f95-ab15-23e915f3aae3" processor="flow-ref">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="check-duplicate-order-subflow" attributeName="name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[payload]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock DB Transaction Success" doc:id="f791bae8-446f-44dd-9bbe-bbd3617ddaaa" processor="flow-ref">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="persist-order-transactionally-subflow" attributeName="name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[payload]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock S3 Put Success" doc:id="d03d566c-a2b5-4f11-a2bc-d3cecf1c593d" processor="s3:put-object">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Put Object" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value='#[{ eTag: "mock-etag-123" }]' mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock Object Store Success" doc:id="27c7c283-3b9a-4f67-9c80-13e289afa2c3" processor="os:store">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Store" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[true]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<munit:set-event doc:name="Set Happy Path Order Payload" doc:id="c7fc7de6-907a-4df0-ada9-579a6b8e8109" >
				<munit:payload value='#[{&#10;  externalOrderId: "ORD-MUNIT-1001",&#10;  orderSource: "WEB",&#10;  marketplace: "US",&#10;  requestTime: "2026-04-07T10:15:30Z",&#10;  customer: {&#10;    customerId: "CUST-1001",&#10;    customerType: "REGISTERED",&#10;    email: "john@example.com",&#10;    firstName: "John",&#10;    lastName: "Doe",&#10;    phone: "+1-214-555-0101"&#10;  },&#10;  items: [&#10;    {&#10;      lineNumber: 1,&#10;      sellerId: "SELLER-100",&#10;      productId: "SKU-101",&#10;      sku: "SKU-101-BLK-9",&#10;      productName: "Running Shoes",&#10;      quantity: 2,&#10;      unitPrice: 25.5,&#10;      listPrice: 30,&#10;      itemDiscount: 4.5,&#10;      taxAmount: 3.2,&#10;      currency: "USD",&#10;      fulfillmentType: "SHIP"&#10;    }&#10;  ],&#10;  pricing: {&#10;    subtotal: 51,&#10;    itemDiscountTotal: 4.5,&#10;    shippingAmount: 4.99,&#10;    taxAmount: 3.2,&#10;    orderDiscountTotal: 2,&#10;    grandTotal: 52.69,&#10;    currency: "USD"&#10;  },&#10;  payment: {&#10;    paymentMethodType: "CARD",&#10;    paymentToken: "tok_abc123xyz",&#10;    paymentProvider: "STRIPE",&#10;    authorizedAmount: 52.69,&#10;    currency: "USD"&#10;  }&#10;}]' mediaType="application/java" />
			</munit:set-event>
			<flow-ref doc:name="Invoke POST Orders Flow" doc:id="e2ace01c-1aaf-4942-825e-456dcfaae514" name="post:\orders:application\json:order-experience-api-config"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert Success Status" doc:id="4fd860a7-df85-4f2e-ade4-27d5fc50d6dc" is='#[MunitTools::equalTo("SUCCESS")]' expression="#[payload.status]"/>
			<munit-tools:assert-that doc:name="Assert Order Id" doc:id="b65459ec-61ee-4dba-a5b5-4cf659d1a646" expression="#[payload.orderId]" is='#[MunitTools::equalTo("ORD-MUNIT-1001")]'/>
			<munit-tools:assert-that doc:name="Assert Correlation Id" doc:id="745d52ef-a527-4e1e-b6b0-a6801389a5c2" expression="#[payload.correlationId]" is='#[MunitTools::notNullValue()]'/>
			<munit-tools:assert-that doc:name="Assert S3 Key Contains Order Id" doc:id="b11e0530-88e4-49b5-97c3-9239115392a3" expression="#[payload.data.key]" is='#[MunitTools::containsString("ORD-MUNIT-1001")]'/>
			<munit-tools:assert-that doc:name="Assert Order Created Code" doc:id="b88df35b-c7e7-4ddc-bea4-de430de9e68b" is='#[MunitTools::equalTo("ORDER_CREATED")]' expression="#[payload.code]"/>
			<munit-tools:verify-call doc:name="Verify Duplicate Check Called Once" doc:id="8cb8742d-2119-4620-a0af-3c1ba94e7a81" processor="flow-ref" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="check-duplicate-order-subflow" attributeName="name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call doc:name="Verify DB Transaction Called Once" doc:id="d55bada7-55a3-4112-9165-4f1215696d09" processor="flow-ref" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Persist Order Transactionally" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call doc:name="Verify S3 Put Called Once" doc:id="9a1250cf-9623-4c7e-a492-2b31c027efc7" processor="s3:put-object" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Put Object" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
			<munit-tools:verify-call doc:name="Verify Object Store Called Once" doc:id="de9338ed-4aa2-4c02-bbc3-af6ff8215549" processor="os:store" times="1">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Store" attributeName="doc:name" />
				</munit-tools:with-attributes>
			</munit-tools:verify-call>
		</munit:validation>
	</munit:test>
