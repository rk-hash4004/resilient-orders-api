	<munit:test name="post-orders-db-failure-500-test" doc:id="9b59ab56-2bc9-473a-ad8b-20792bfc298c">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock Duplicate Check Not Found" doc:id="cd63b3e4-9e52-42ce-9e1c-e415537c92d7" processor="os:contains" >
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="Check Order Exists" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="isDuplicateOrder" value="#[false]" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when doc:name="Mock DB Insert Connectivity Error" doc:id="ba73bf59-abd7-42f6-8025-01840017d3be" processor="db:insert">
