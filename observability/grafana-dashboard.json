{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "title": "Order pipeline health (RED + USE)",
  "uid": "order-pipeline-health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request rate (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "expr": "sum(rate(traces_span_metrics_calls_total{span_name=\"POST /api/*\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 2, "type": "stat", "title": "Error rate (% of requests)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "expr": "100 * (sum(rate(traces_span_metrics_calls_total{span_name=\"POST /api/*\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{span_name=\"POST /api/*\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 5 } ] } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "p95 latency (ms)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"POST /api/*\"}[$__rate_interval])))" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 2000 } ] } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Total requests (range)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "expr": "sum(increase(traces_span_metrics_calls_total{span_name=\"POST /api/*\"}[$__range]))" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 5, "type": "timeseries", "title": "RED: requests per second by span status",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "legendFormat": "{{status_code}}", "expr": "sum by (status_code) (rate(traces_span_metrics_calls_total{span_name=\"POST /api/*\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "RED: request latency p50 / p95 (ms)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"POST /api/*\"}[$__rate_interval])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_span_metrics_duration_milliseconds_bucket{span_name=\"POST /api/*\"}[$__rate_interval])))" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 7, "type": "timeseries", "title": "Where time goes: average duration of DB and Kafka steps (ms)",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "legendFormat": "{{span_name}}", "expr": "sum by (span_name) (rate(traces_span_metrics_duration_milliseconds_sum{span_name=~\"db:.*|kafka:.*\"}[$__rate_interval])) / sum by (span_name) (rate(traces_span_metrics_duration_milliseconds_count{span_name=~\"db:.*|kafka:.*\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 8, "type": "timeseries", "title": "USE: JVM memory used (bytes)",
      "gridPos": { "x": 0, "y": 21, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "legendFormat": "{{jvm_memory_type}}", "expr": "sum by (jvm_memory_type) (jvm_memory_used_bytes)" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 9, "type": "timeseries", "title": "USE: JVM CPU utilization",
      "gridPos": { "x": 8, "y": 21, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "legendFormat": "cpu", "expr": "jvm_cpu_recent_utilization_ratio" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 10, "type": "timeseries", "title": "USE: JVM thread count",
      "gridPos": { "x": 16, "y": 21, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "legendFormat": "threads", "expr": "sum(jvm_thread_count)" } ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    }
  ]
}
